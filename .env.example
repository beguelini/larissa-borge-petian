# Configure apenas no servidor da Vercel. Nunca prefixe estas variaveis com VITE_.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key
# E-mail transacional do resultado do questionário. Use somente no servidor.
RESEND_API_KEY=re_sua-chave-privada
RESEND_FROM_EMAIL=Larissa Petian <ola@larissaborgepetian.com.br>
# Segredo enviado pelo cron da Vercel no header Authorization: Bearer.
CRON_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
# Habilite somente no projeto Vercel de produção da Larissa.
LARISSA_DAILY_REPORT_ENABLED=false
# Integração Hotmart. Configure somente no servidor e nunca compartilhe o Hottok.
HOTMART_HOTTOK=seu-token-secreto-da-hotmart
# Opcional: produto que libera acesso à área de membros. As vendas de todos os produtos do webhook continuam sendo registradas.
HOTMART_PRODUCT_ID=id-numerico-do-produto-meu-ritmo
# Credenciais exclusivas do painel administrativo. Nunca use prefixo VITE_.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=escolha-uma-senha-forte
DASHBOARD_SESSION_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
